# syntax=docker/dockerfile:1

ARG GO_IMAGE=docker.io/library/golang:1.26-alpine3.24@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468
ARG ALPINE_IMAGE=docker.io/library/alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS frontend-build
RUN apk --no-cache add build-base git nodejs pnpm
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY --exclude=.git/ . .
RUN make frontend

FROM ${GO_IMAGE} AS build-env

ARG GITEA_VERSION
ARG TAGS=""
ENV TAGS="bindata timetzdata $TAGS"
ARG CGO_EXTRA_CFLAGS

RUN apk --no-cache add build-base git
WORKDIR ${GOPATH}/src/gitea.dev
COPY go.mod go.sum ./
RUN go mod download
COPY --exclude=.git/ . .
COPY --from=frontend-build /src/public/assets public/assets
RUN --mount=type=cache,target="/root/.cache/go-build" \
    --mount=type=bind,source=".git/",target=".git/" \
    make backend

COPY docker/rootless /tmp/local
RUN chmod 755 /tmp/local/usr/local/bin/* /go/src/gitea.dev/gitea

FROM ${ALPINE_IMAGE} AS gitea-rootless

ARG GITEA_VERSION
ARG GITEA_UPSTREAM_VERSION
ARG GITEA_UPSTREAM_COMMIT
ARG GITEA_PATCH_REVISION
ARG SOURCE_DATE_EPOCH

LABEL org.opencontainers.image.title="Gitea with Actions workload identity" \
      org.opencontainers.image.description="Rootless Gitea with OIDC workload identity for Actions" \
      org.opencontainers.image.source="https://github.com/lazypower/gitea-workload-identity" \
      org.opencontainers.image.url="https://github.com/lazypower/gitea-workload-identity" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="$GITEA_UPSTREAM_VERSION" \
      org.opencontainers.image.revision="$GITEA_PATCH_REVISION" \
      io.gitea.upstream.commit="$GITEA_UPSTREAM_COMMIT" \
      io.gitea.image.variant="rootless" \
      io.gitea.build.source-date-epoch="$SOURCE_DATE_EPOCH"

EXPOSE 2222 3000
RUN apk --no-cache add bash ca-certificates dumb-init gettext git curl gnupg openssh-keygen
RUN addgroup -S -g 1000 git && \
    adduser -S -H -D -h /var/lib/gitea/git -s /bin/bash -u 1000 -G git git
RUN mkdir -p /var/lib/gitea /etc/gitea && chown git:git /var/lib/gitea /etc/gitea

COPY --from=build-env /tmp/local /
COPY --from=build-env --chown=root:root /go/src/gitea.dev/gitea /app/gitea/gitea

USER 1000:1000
ENV GITEA_WORK_DIR=/var/lib/gitea \
    GITEA_CUSTOM=/var/lib/gitea/custom \
    GITEA_TEMP=/tmp/gitea \
    TMPDIR=/tmp/gitea \
    GITEA_APP_INI=/etc/gitea/app.ini \
    HOME=/var/lib/gitea/git
VOLUME ["/var/lib/gitea", "/etc/gitea"]
WORKDIR /var/lib/gitea
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD []
