<h4 class="ui top attached header">
	{{ctx.Locale.Tr "settings.authorized_oauth2_applications"}}
</h4>
<div class="ui attached segment">
	<div class="flex-divided-list items-with-main">
		<div class="item">
			{{ctx.Locale.Tr "settings.authorized_oauth2_applications_description"}}
		</div>
		{{range .Grants}}
			<div class="item">
				<div class="item-leading">
					{{svg "octicon-key" 32}}
				</div>
				<div class="item-main">
					<div class="item-title">{{.Application.Name}}</div>
					<div class="item-body{{if .MCPProfile.Name}} tw-flex-col tw-items-start{{end}}">
						{{if .MCPProfile.Name}}
							<div>{{ctx.Locale.Tr "settings.mcp_registration_unverified"}}</div>
							{{if .Application.MCPInstallationLabel}}<div>{{ctx.Locale.Tr "settings.mcp_registration_installation" .Application.MCPInstallationLabel}}</div>{{end}}
							<div><b>{{ctx.Locale.Tr "auth.authorize_mcp_profile" (ctx.Locale.Tr (printf "auth.mcp_profile.%s" .MCPProfile.Name))}}</b></div>
							<div>{{ctx.Locale.Tr "settings.mcp_grant_scopes"}} <code>{{.Scope}}</code></div>
							<div>{{ctx.Locale.Tr "settings.mcp_grant_authorized"}} {{DateUtils.FullTime .CreatedUnix}}</div>
							<div>{{ctx.Locale.Tr "settings.mcp_grant_rotated"}} {{if .CredentialRotatedUnix}}{{DateUtils.FullTime .CredentialRotatedUnix}}{{else}}{{ctx.Locale.Tr "settings.mcp_grant_not_issued"}}{{end}}</div>
							<div>{{if .MCPUsable}}{{ctx.Locale.Tr "settings.mcp_grant_active"}}{{else}}{{ctx.Locale.Tr "settings.mcp_grant_disabled"}}{{end}} · {{ctx.Locale.Tr "auth.mcp_public_pkce"}} · {{ctx.Locale.Tr "settings.mcp_registration_redirect_class" .Application.MCPRedirectClass}}</div>
						{{else}}
						<i>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</i>
						{{end}}
					</div>
				</div>
				<div class="item-trailing">
					<button class="ui red tiny button link-action" data-modal-confirm="#revoke-gitea-oauth2-grant"
							data-url="{{AppSubUrl}}/user/settings/applications/oauth2/{{.ApplicationID}}/revoke/{{.ID}}">
						{{ctx.Locale.Tr "settings.revoke_key"}}
					</button>
				</div>
			</div>
		{{end}}
	</div>

	<div class="ui small modal" id="revoke-gitea-oauth2-grant">
		<div class="header">
			{{svg "octicon-shield" 16 "tw-mr-1"}}
			{{ctx.Locale.Tr "settings.revoke_oauth2_grant"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.revoke_oauth2_grant_description"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
