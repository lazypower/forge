{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "customManagers:githubActionsVersions"],
  "onboarding": false,
  "requireConfig": "required",
  "dependencyDashboard": false,
  "enabledManagers": ["github-actions", "dockerfile", "custom.regex"],
  "branchPrefix": "renovate/",
  "schedule": ["before 8am on Monday"],
  "minimumReleaseAge": "5 days",
  "semanticCommits": "enabled",
  "prConcurrentLimit": 3,
  "dockerfile": {
    "managerFilePatterns": ["/^contrib/workload-identity/image/Dockerfile\\.rootless$/"],
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^contrib/workload-identity/upstream\\.env$/"],
      "matchStrings": [
        "GITEA_CANDIDATE_VERSION=(?<currentValue>[^\\s]+)",
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "go-gitea/gitea",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver",
    },
  ],
  "packageRules": [
    {
      "groupName": "workflow dependencies",
      "matchManagers": ["github-actions"],
    },
    {
      "matchDepNames": ["go-gitea/gitea"],
      "branchPrefix": "workload-identity/upstream-",
      "commitMessageTopic": "Gitea upstream to {{newVersion}}",
      "commitMessageAction": "update",
      "semanticCommitType": "chore",
      "semanticCommitScope": "actions",
      "automerge": false,
      "platformAutomerge": false,
      "prBodyNotes": [
        "Read the upstream release notes, replay the workload-identity patch, and pass the complete verification workflow. A clean rebase is not sufficient for approval.",
      ],
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "workload identity base images",
      "pinDigests": true,
    },
  ],
}
